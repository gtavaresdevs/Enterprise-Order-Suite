DB_NAME=addyourdbnamehere
DB_USER=addyouruserhere
DB_PASSWORD=addyourdbpasswordhere
JWT_SECRET=addyourjwtsecrethere

# Root super admin (optional). Seeded at boot and protected from deactivation, role changes
# and email changes. Leave both blank to skip the seed entirely - nothing else depends on it.
# SUPER_ADMIN_PASSWORD_HASH is a BCRYPT HASH, not a password.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD_HASH=

# Client-IP trust for rate limiting (D23). Leave at none unless a reverse proxy or load
# balancer sits in front; then set native, and add the proxy to
# server.tomcat.remoteip.internal-proxies if its address is not a private range.
SERVER_FORWARD_HEADERS_STRATEGY=none
